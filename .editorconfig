# Editor configuration, see https://editorconfig.org
# O frontend/ tem o proprio .editorconfig com root = true e nao herda deste.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown usa dois espacos no fim da linha como quebra
max_line_length = off
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
